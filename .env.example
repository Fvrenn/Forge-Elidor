# ---------------------------------------------------------------------------
# Backend Medusa (backend/.env)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-db
REDIS_URL=redis://localhost:6379

# Générer des valeurs aléatoires en production : openssl rand -base64 32
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# En production : URLs réelles en https, séparées par des virgules
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# ---------------------------------------------------------------------------
# Storefront Next.js (storefront/.env.local)
# ---------------------------------------------------------------------------
# Attention : la variable n'est PAS préfixée NEXT_PUBLIC_
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Code pays ISO-2 en minuscules, doit exister dans une région Medusa
NEXT_PUBLIC_DEFAULT_REGION=fr

# Paiement (voir docs Medusa : module @medusajs/payment-stripe côté backend)
NEXT_PUBLIC_STRIPE_KEY=
